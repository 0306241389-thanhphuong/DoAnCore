<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Trản Quản Trị Admin</title>

    <!-- 1. Đổi tất cả đường dẫn CSS trỏ vào ~/admin/ -->
    <link href="~/admin/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/admin/css/metisMenu.min.css" rel="stylesheet">
    <link href="~/admin/css/timeline.css" rel="stylesheet">
    <link href="~/admin/css/startmin.css" rel="stylesheet">
    <link href="~/admin/css/font-awesome.min.css" rel="stylesheet" type="text/css">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <div id="wrapper">
        <!-- NAVBAR ADMIN & SIDEBAR MENU -->
        <nav class="navbar navbar-inverse navbar-fixed-top" role="navigation">
            <div class="navbar-header">
                <a class="navbar-brand" href="/Admin">Admin Panel</a>
            </div>

            <!-- MENU DỌC BÊN TRÁI (SIDEBAR) -->
            <div class="navbar-default sidebar" role="navigation">
                <div class="sidebar-nav navbar-collapse">
                    <ul class="nav" id="side-menu">
                        <li>
                            <a href="/Admin/Category"><i class="fa fa-folder fa-fw"></i> Quản lý Danh mục</a>
                        </li>
                        <li>
                            <a href="/Admin/Product"><i class="fa fa-cube fa-fw"></i> Quản lý Sản phẩm</a>
                        </li>
                        <li>
                            <a href="/Admin/Order"><i class="fa fa-shopping-cart fa-fw"></i> Quản lý Đơn hàng</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <!-- NỘI DUNG CHÍNH CỦA TRANG ADMIN -->
        <div id="page-wrapper">
            <div class="container-fluid">
                <div class="row">
                    <div class="col-lg-12">
                        <!-- Nơi hiển thị view của Category, Product, Order -->
                        @RenderBody()
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Đổi tất cả đường dẫn JS trỏ vào ~/admin/ -->
    <script src="~/admin/js/jquery.min.js"></script>
    <script src="~/admin/js/bootstrap.min.js"></script>
    <script src="~/admin/js/metisMenu.min.js"></script>
    <script src="~/admin/js/startmin.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>